{
  "name": "alpha-platform",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "seed": "tsx server/seed.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "admin:promote": "tsx scripts/promote-admin.ts",
    "db:export:postgres": "tsx scripts/export-postgres.ts",
    "test:postgres": "tsx --test --test-concurrency=1 tests/postgres/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.4.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "web-push": "^4.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.5",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
