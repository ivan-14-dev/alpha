# Alpha — production settings for deploy/compose.yaml.
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
# Every variable is documented in /.env.example and docs/deployment.md.
# compose.yaml already sets NODE_ENV, HOST, PORT, DATABASE_PATH, FILES_DIR, BACKUP_DIR, TRUST_PROXY and CLAMAV_HOST.

# --- Domain & TLS (Caddy) ---------------------------------------------------------------------------------------
ALPHA_DOMAIN=alpha.example.org
ACME_EMAIL=ops@example.org
APP_ORIGIN=https://alpha.example.org
# PUBLIC_API_ORIGIN=https://alpha.example.org

# --- Secrets (required) -----------------------------------------------------------------------------------------
# openssl rand -base64 32   — store a copy in your password manager: it is NOT in the backups.
ALPHA_SECRETS_KEY=
# ALPHA_SECRETS_KEY_PREVIOUS=

# --- E-mail (required for account verification and password resets) -----------------------------------------
SMTP_URL=smtps://user:password@smtp.example.org:465
MAIL_FROM="Alpha <no-reply@alpha.example.org>"

# --- Monitoring -------------------------------------------------------------------------------------------------
# openssl rand -hex 32   (Prometheus: authorization.credentials). Leave empty to disable /api/system/metrics.
METRICS_TOKEN=

# --- Logs -------------------------------------------------------------------------------------------------------
LOG_LEVEL=info

# --- Sandbox on a remote Docker host (optional) -----------------------------------------------------------------
# ALPHA_SANDBOX_DOCKER_HOST=tcp://sandbox.internal:2376
# ALPHA_SANDBOX_DOCKER_TLS_VERIFY=1
# ALPHA_SANDBOX_DOCKER_CERT_PATH=/run/secrets/sandbox-docker
# ALPHA_SANDBOX_IMAGE_ALLOWLIST=alpine,node,python,eclipse-temurin

# --- Image ------------------------------------------------------------------------------------------------------
# One tag per deployed version: the previous image stays available for an immediate rollback.
ALPHA_IMAGE=alpha-platform:0.4.0
# Registry image instead of building on the server: ghcr.io/your-org/alpha-platform:0.4.0
# ALPHA_VCS_REF=                                       # git commit recorded in the image labels

# --- PostgreSQL export target (docker compose --profile postgres) -----------------------------------------------
# POSTGRES_DB=alpha
# POSTGRES_USER=alpha
# POSTGRES_PASSWORD=
# Export: docker compose run --rm --no-deps -e ALPHA_PG_URL=postgres://alpha:<password>@postgres:5432/alpha app npm run db:export:postgres
