# Alpha — environment variables (reference). Copy to `.env` for local development: `cp .env.example .env`.
# Production with Docker Compose: use deploy/.env.example instead (docs/deployment.md).
# Never commit a real `.env` (ignored by git). Values below are development defaults; commented lines are optional.

# --- Server -------------------------------------------------------------------------------------------------------
# NODE_ENV=production           # production: Secure cookies, JSON logs, ALPHA_SECRETS_KEY + APP_ORIGIN required
PORT=3001
# HOST=127.0.0.1                # 0.0.0.0 in containers
# TRUST_PROXY=1                 # number of reverse proxies in front (1 behind Caddy). Never set without a proxy.
# LOG_LEVEL=info                # debug | info | warn | error
# LOG_FORMAT=json               # json (default in production) | pretty (default in development)

# --- Public URLs --------------------------------------------------------------------------------------------------
# Origin of the web app (CSRF origin check, links in e-mails, OAuth redirects). HTTPS in production.
APP_ORIGIN=http://127.0.0.1:5173
# Public origin of the API for payment/integration webhooks when it differs from APP_ORIGIN.
# PUBLIC_API_ORIGIN=https://api.example.org
# VITE_PORT=5173                # dev only: used to build the default APP_ORIGIN

# --- Data ---------------------------------------------------------------------------------------------------------
DATABASE_PATH=./data/alpha.sqlite
# FILES_DIR=./data/files        # uploaded files (encrypted at rest). Default: <dir of DATABASE_PATH>/files
# BACKUP_DIR=./data/backups     # npm run backup / ops.backup job. Default: <dir of DATABASE_PATH>/backups

# --- Secrets ------------------------------------------------------------------------------------------------------
# 32 random bytes, base64 or 64 hex chars: `openssl rand -base64 32`. Required in production.
# Encrypts provider keys, SMTP password, MFA secrets, OAuth tokens, KYC documents and stored files.
# NOT included in backups: keep it in a password manager. Losing it makes encrypted data unrecoverable.
# Development without it: a key is generated next to the database (data/.alpha-secrets.key).
# ALPHA_SECRETS_KEY=
# Previous keys (comma separated) still accepted for decryption during a rotation (docs/operations.md).
# ALPHA_SECRETS_KEY_PREVIOUS=

# --- E-mail -------------------------------------------------------------------------------------------------------
# SMTP transport (otherwise configurable in Admin > E-mails; without any transport e-mails are only logged in dev).
# SMTP_URL=smtps://user:password@smtp.example.org:465
# SMTP_URL=smtp://127.0.0.1:1025   # Mailpit (docker compose --profile dev)
# MAIL_FROM="Alpha <no-reply@example.org>"
# MAIL_LOG_BODY=1               # dev only: print e-mail bodies on stdout

# --- Background jobs ----------------------------------------------------------------------------------------------
# ALPHA_JOBS=off                # disable the in-process scheduler on this instance (tests, one-off containers)

# --- Antivirus (files module) ---------------------------------------------------------------------------------------
# clamd TCP address. The admin setting "Fichiers & antivirus" takes precedence when saved.
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=120000   # large builds (200 MB) need ~2 min; also raise clamd StreamMaxLength (deploy/clamav/clamd.conf)

# --- Sandbox (isolated execution of tested software) -------------------------------------------------------------
# REMOTE, dedicated Docker host. Never the platform host's own socket in production.
# ALPHA_SANDBOX_DOCKER_HOST=tcp://sandbox.internal:2376
# ALPHA_SANDBOX_DOCKER_TLS_VERIFY=1
# ALPHA_SANDBOX_DOCKER_CERT_PATH=/run/secrets/sandbox-docker   # ca.pem, cert.pem, key.pem
# ALPHA_SANDBOX_DOCKER_CONFIG=  # docker CLI config dir (registry credentials)
# ALPHA_SANDBOX_DOCKER_BIN=docker
# ALPHA_SANDBOX_IMAGE_ALLOWLIST=alpine,node,python,eclipse-temurin     # locks the image allowlist (admin cannot widen it)
# ALPHA_SANDBOX_INSTANCE=       # label for this platform's containers on a shared daemon (default: hash of APP_ORIGIN)
# ALPHA_SANDBOX_WORK_DIR=./data/sandbox-work
# ALPHA_SANDBOX_ENTRY=./sandbox/entry.sh
# DOCKER_HOST / DOCKER_TLS_VERIFY / DOCKER_CERT_PATH are used as fallbacks when the ALPHA_SANDBOX_* variants are unset.

# --- Monitoring ---------------------------------------------------------------------------------------------------
# Bearer token for GET /api/system/metrics (Prometheus). Unset or < 24 characters: endpoint answers 404.
# METRICS_TOKEN=                # openssl rand -hex 32

# --- Legal texts (privacy module) --------------------------------------------------------------------------------
# Directory of the Markdown legal documents (default: docs/legal/ of the code base, included in the Docker image).
# LEGAL_DOCS_DIR=/srv/alpha-legal

# --- PostgreSQL export (npm run db:export:postgres, npm run test:postgres) --------------------------------------
# Target database; preferred over `--pg <url>` so the password does not appear in `ps`.
# ALPHA_PG_URL=postgres://alpha:password@127.0.0.1:5432/alpha

# --- Demo data (npm run seed) ------------------------------------------------------------------------------------
# Use a long, unique password when creating local demonstration accounts:
# DEMO_PASSWORD=
